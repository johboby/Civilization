; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited via text if needed.

[application]

config/name="Civilization Online RPG"
config/description="Grand Strategy RPG inspired by Romance of the Three Kingdoms 14 and Europa Universalis 4"
config/version="0.1.0"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.2")
config/icon="res://icon.svg"

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="viewport"
window/stretch/aspect="expand"

